\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces SINR heatmaps at time step $t_0$. (a)\nobreakspace  {}Static placement produces vast dead zones (purple, SINR\,$<$\,5\,dB) with only 16.6\% coverage. (b)\nobreakspace  {}After APSO optimization, routers reposition and re-steer beams to achieve 100.0\% coverage.\relax }}{4}{figure.caption.2}\protected@file@percent }
\newlabel{fig:sinr}{{2}{4}{SINR heatmaps at time step $t_0$. (a)~Static placement produces vast dead zones (purple, SINR\,$<$\,5\,dB) with only 16.6\% coverage. (b)~After APSO optimization, routers reposition and re-steer beams to achieve 100.0\% coverage.\relax }{figure.caption.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}4.2 Optimization Time}{4}{subsection.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces APSO optimization wall-clock time per time step. Warm-starting from previous solutions at $t_1$ and $t_2$ reduces convergence time drastically from $\sim $138s down to $\sim $35s and $\sim $18s, demonstrating efficient incremental re-optimization.\relax }}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:opt_time}{{3}{4}{APSO optimization wall-clock time per time step. Warm-starting from previous solutions at $t_1$ and $t_2$ reduces convergence time drastically from $\sim $138s down to $\sim $35s and $\sim $18s, demonstrating efficient incremental re-optimization.\relax }{figure.caption.3}{}}
